# Copy to .env and fill in. Every Settings field appears here —
# tests/unit/test_config.py::test_env_example_covers_all_fields enforces it.

# ── Environment ────────────────────────────────────────────────────
ENV=local
LOG_LEVEL=INFO

# ── Provider selection ─────────────────────────────────────────────
# Switch TTS at runtime if the primary degrades. No code change needed.
STT_PROVIDER=deepgram      # deepgram | fake
TTS_PROVIDER=azure         # azure | inworld | fake
LLM_PROVIDER=claude        # claude | openrouter | fake
# openrouter adds a proxy hop (~50-200ms) against the 300ms TTFT budget.
# Fine for development; measure both in TASK-12 before production.

# ── Credentials ────────────────────────────────────────────────────
# console.anthropic.com
ANTHROPIC_API_KEY=
# openrouter.ai/keys — only if LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# console.deepgram.com — $200 free credit, no card, no expiry
DEEPGRAM_API_KEY=
# portal.azure.com > Speech service — 500k chars/month free forever
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia   # closest to PK; do NOT use a US region
# platform.inworld.ai (optional — only if TTS_PROVIDER=inworld)
INWORLD_API_KEY=

# cloud.livekit.io — free Build tier
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Model ──────────────────────────────────────────────────────────
LLM_MODEL=claude-opus-5    # openrouter auto-prefixes to anthropic/claude-opus-5
LLM_EFFORT=low             # low | medium — higher blows the TTFT budget
LLM_FAST_MODE=false        # Opus 5 fast mode: ~2.5x output speed at $10/$50 per MTok
LLM_MAX_TOKENS=400         # a spoken turn is short; caps runaway responses

# ── Language ───────────────────────────────────────────────────────
STT_LANGUAGE=ur
TTS_VOICE_URDU=ur-PK-UzmaNeural     # or ur-PK-AsadNeural
TTS_VOICE_ENGLISH=en-US-AriaNeural

# ── Latency budget (ms) ────────────────────────────────────────────
BUDGET_TTFT_MS=300
BUDGET_TTS_TTFB_MS=110
BUDGET_TOTAL_MS=800
ENDPOINT_SILENCE_MS=180    # tune against real PK call audio in TASK-09

# ── Data ───────────────────────────────────────────────────────────
# Non-default ports. A native Postgres/Redis install often already owns 5432 or
# 6379, and the collision shows up as "password authentication failed", not as a
# port conflict, because the host resolves localhost to the other server.
DATABASE_URL=postgresql://agent:localdev@127.0.0.1:55432/voiceagent
REDIS_URL=redis://127.0.0.1:56379/0

# ── Knowledge ──────────────────────────────────────────────────────
# Local ONNX embeddings: no API key, and no network hop on the prefetch path.
# First run downloads ~2.24GB. "hash" is deterministic and for tests only.
EMBEDDING_PROVIDER=fastembed        # fastembed | hash
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIMENSIONS=1024            # must match the model; re-ingest if changed

RETRIEVAL_TOP_K=4
ANSWER_CACHE_TTL_S=3600
ANSWER_CACHE_THRESHOLD=0.93

# ---- voice mode ------------------------------------------------------------
# "realtime": one OpenAI socket does listening, thinking and speaking.
#   ~520ms to first audio vs ~2,540ms for the three-vendor pipeline, and the
#   voices were preferred to Azure ur-PK by a native speaker.
# "pipeline": Deepgram + LLM + Azure. Kept because realtime puts the entire
#   voice path behind one vendor.
VOICE_MODE=realtime
REALTIME_MODEL=gpt-realtime
# marin | cedar | alloy | shimmer
REALTIME_VOICE=cedar
# Used by the realtime path; falls back to OPENROUTER_API_KEY if unset.
OPENAI_API_KEY=
