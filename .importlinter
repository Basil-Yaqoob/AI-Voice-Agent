[importlinter]
root_packages =
    agent
include_external_packages = True

[importlinter:contract:providers-are-isolated]
name = Vendor SDKs may only be imported inside their own adapter
type = forbidden
source_modules =
    agent.pipeline
    agent.language
    agent.knowledge
    agent.interfaces
    agent.telemetry
    agent.data
forbidden_modules =
    anthropic
    openai
    deepgram
    azure

[importlinter:contract:transport-owns-livekit]
name = Only the transport layer may know about rooms and tracks
type = forbidden
source_modules =
    agent.pipeline
    agent.language
    agent.knowledge
    agent.interfaces
    agent.telemetry
    agent.data
    agent.tools
    agent.providers
    agent.api
forbidden_modules =
    livekit

[importlinter:contract:data-layer-is-generic]
name = The database adapter must not know which business it serves
type = forbidden
source_modules =
    agent.data
forbidden_modules =
    agent.tools
    agent.pipeline
    agent.providers

[importlinter:contract:interfaces-are-pure]
name = Interfaces must not depend on implementations
type = forbidden
source_modules =
    agent.interfaces
forbidden_modules =
    agent.providers
    agent.pipeline
